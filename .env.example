# Get this from https://console.anthropic.com/ (hackathon Claude credits)
ANTHROPIC_API_KEY=sk-ant-...

# Database:
# - Leave unset OR use file:… → SQLite local (default, zero setup)
# - postgresql://… → Postgres (Neon / Vercel Postgres) for production
# DATABASE_URL=file:./data/sandbox.sqlite
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_REFINE_MODEL=claude-haiku-4-5-20251001
# Post-run LLM-as-judge (defaults to refine model)
ANTHROPIC_JUDGE_MODEL=claude-haiku-4-5-20251001
PORT=8787
WEB_ORIGIN=http://localhost:5173
MAX_TURNS_PER_AGENT=12

# Public demo protections (see README "Public demo protections"); 0 disables a limit.
# RATE_LIMIT_PER_MINUTE=3
# MAX_RUNS_PER_DAY=40
# MAX_CONCURRENT_RUNS=3
# MAX_JUDGE_CALLS_PER_DAY=200
# Hard US$ ceiling per UTC day for the HTTP server, from response usage (resets on restart).
# MAX_SPEND_USD_PER_DAY=5
# Required header x-admin-token for writes when set. Leave unset locally.
# ADMIN_TOKEN=
# Block writes when ADMIN_TOKEN is missing (always on when RENDER is set).
# REQUIRE_ADMIN_TOKEN=1
# Open every write to anyone, even with ADMIN_TOKEN set or on Render (disposable demo data).
# ALLOW_PUBLIC_WRITES=1
# Serve git-ignored real-mailbox scenario files over HTTP (local only).
# ALLOW_REAL_EMAIL_FILES=1
