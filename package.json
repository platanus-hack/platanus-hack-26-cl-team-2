{
  "name": "agent-monitor-sandbox",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "MVP sandbox: two real Claude agents interacting under a monitorable harness",
  "scripts": {
    "dev": "pnpm --parallel --filter @sandbox/api --filter @sandbox/web dev",
    "dev:api": "pnpm --filter @sandbox/api dev",
    "dev:web": "pnpm --filter @sandbox/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "db:seed": "pnpm --filter @sandbox/api db:seed"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
